{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "cleanUrls":true,
  "headers":[
    {"source":"/","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/index.html","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/assets/doox-v3.js","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/assets/doox-v3.css","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/assets/doox-control-v3.js","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/assets/doox-control-v3.css","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/assets/(.*)\\.(mp4|mp3|webm|png|jpg|jpeg|svg|ico)$","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
    {"source":"/hocco-controle","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow, noarchive, nosnippet"},{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/doox-access-fRiqxdGcydxi5UvdiW89JcVt","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow, noarchive, nosnippet"},{"key":"Cache-Control","value":"no-store, max-age=0"}]}
  ],
  "routes":[
    {"src":"/hocco-controle","dest":"/doox-control-v3.html"},
    {"src":"/doox-access-fRiqxdGcydxi5UvdiW89JcVt","dest":"/doox-control-v3.html"},
    {"src":"/(portal|serie|empresas|insercoes|simulacao|participar|posicao|cadastro|materiais|revisao|acompanhar|pagamento|termos|privacidade|regras)","dest":"/"}
  ]
}
