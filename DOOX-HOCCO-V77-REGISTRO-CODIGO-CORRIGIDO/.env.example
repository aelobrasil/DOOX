# Supabase Postgres connection string.
# IMPORTANTE: NÃO coloque aqui https://SEU-PROJETO.supabase.co.
# Use the Supabase transaction pooler connection for Vercel/serverless.
DOOX_DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres

# URL pública do projeto Supabase (usada pelo Storage).
SUPABASE_URL=https://txbowobtfiiqqatqjfpd.supabase.co
# Chave service_role do Supabase — somente no ambiente da Vercel, nunca no frontend.
SUPABASE_SERVICE_ROLE_KEY=COLE_A_SERVICE_ROLE_KEY_AQUI

# Secret used to sign private tracking tokens.
# Generate a long random value and keep it only in Vercel.
DOOX_TRACKING_SECRET=COLE_UMA_CHAVE_LONGA_E_ALEATORIA

# Secret used by the private DOOX CONTROL API.
DOOX_ADMIN_SECRET=RECOMENDADO_DEFINIR_UMA_CHAVE_SECRETA_NO_VERCEL
# Ou use DOOX_ADMIN_PASSWORD_HASH para substituir a senha padrão do DOOX Core.

# Public base URL used in the tracking link.
DOOX_PUBLIC_BASE_URL=https://doox-omega.vercel.app

# Optional tracking lifetime. Default: 3650 days.
DOOX_TRACKING_TTL_DAYS=3650

# Optional private admin session lifetime in hours. Default: 12.
DOOX_ADMIN_SESSION_HOURS=12
