# PostgreSQL / Supabase Transaction Pooler. Nunca use a URL https://... aqui.
DOOX_DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres

# Supabase Storage — somente no servidor Vercel.
SUPABASE_URL=https://txbowobtfiiqqatqjfpd.supabase.co
SUPABASE_SERVICE_ROLE_KEY=COLE_A_SERVICE_ROLE_KEY_AQUI

# Assinatura dos links privados de acompanhamento.
DOOX_TRACKING_SECRET=COLE_UMA_CHAVE_LONGA_E_ALEATORIA
DOOX_TRACKING_TTL_DAYS=3650

# Administração do DOOX Core V2.
DOOX_ADMIN_SECRET=COLE_UMA_CHAVE_LONGA_E_ALEATORIA
# Opcional: hash scrypt da senha administrativa. Se omitido, a aplicação mantém o hash padrão já usado pelo projeto.
DOOX_ADMIN_PASSWORD_HASH=
DOOX_ADMIN_SESSION_HOURS=12

# Domínio público do site.
DOOX_PUBLIC_BASE_URL=https://doox-omega.vercel.app
