7:["$","p",null,{"children":"Quando uma solicitação paga for recusada, o motivo será registrado e o pedido entrará em processo de reembolso. O status “reembolsado” somente será utilizado depois da efetivação operacional do reembolso."}]
8:["$","h2",null,{"children":"7. Relatórios"}]
9:["$","p",null,{"children":"Relatórios podem incluir Hypes válidos, pessoas únicas, interações, visitas, benefícios e direcionamentos ao WhatsApp. Um direcionamento ao WhatsApp representa intenção de contato, não venda comprovada."}]
a:["$","h2",null,{"children":"8. Materiais e marca"}]
b:["$","p",null,{"children":"Ao enviar logo e dados comerciais, o solicitante declara possuir autorização para utilizá-los e permite seu uso estritamente para a operação e divulgação da participação contratada."}]
