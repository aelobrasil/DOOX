7:["$","p",null,{"children":"Elementos comunitários podem exibir nome público, username, avatar, nível, XP e ofensiva. E-mail, telefone, dados financeiros e notas internas da Curadoria não são exibidos na comunidade."}]
8:["$","h2",null,{"children":"6. Compartilhamento"}]
9:["$","p",null,{"children":"Dados podem ser processados por provedores tecnológicos necessários à operação, como autenticação, banco de dados e hospedagem. Empresas participantes recebem apenas as informações necessárias ao benefício ou contato iniciado pelo próprio membro."}]
a:["$","h2",null,{"children":"7. Segurança"}]
b:["$","p",null,{"children":"Utilizamos autenticação, controles de acesso, políticas de banco, registros de auditoria e validações server-side. Nenhum sistema é absolutamente infalível; incidentes relevantes serão tratados conforme a legislação aplicável."}]
c:["$","h2",null,{"children":"8. Direitos e retenção"}]
d:["$","p",null,{"children":"O titular pode solicitar informações sobre seus dados e, quando aplicável, correção ou exclusão, observadas obrigações legais, antifraude e registros que precisem ser preservados."}]
e:["$","h2",null,{"children":"9. Contato"}]
f:["$","p",null,{"children":"Questões operacionais podem ser encaminhadas pelos canais oficiais disponibilizados dentro do aplicativo."}]
