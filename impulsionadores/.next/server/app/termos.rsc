6:["$","h2",null,{"children":"5. Impulsão"}]
7:["$","p",null,{"children":"Impulsão é apoio financeiro voluntário à HOCCO, a partir de R$ 3,00. Não constitui investimento, participação societária, aplicação financeira ou promessa de retorno. Uma Impulsão não compra HC, Hypes, ranking ou prioridade em experiências."}]
8:["$","h2",null,{"children":"6. Benefícios de empresas"}]
9:["$","p",null,{"children":"Benefícios são oferecidos pelas empresas participantes e podem possuir validade, condições e exceções próprias. O aplicativo registra o direcionamento ao WhatsApp como intenção de contato, não como venda realizada."}]
a:["$","h2",null,{"children":"7. Integridade"}]
b:["$","p",null,{"children":"A HOCCO pode invalidar ações automatizadas, abusivas ou incompatíveis com estas regras, preservar evidências operacionais e restringir contas quando necessário para proteger a comunidade e a integridade do produto."}]
c:["$","h2",null,{"children":"8. Alterações"}]
d:["$","p",null,{"children":"Regras e funcionalidades podem evoluir. Alterações materiais serão apresentadas em nova versão para aceite quando necessário."}]
